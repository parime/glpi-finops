msgstr "%s vCPU przydzielonych"

#, php-format
msgid "%s virtual machines"
msgstr "%s maszyn wirtualnych"

msgid "Asset in GLPI"
msgstr "Zasób w GLPI"

msgid "Check the allocations, then confirm the proposed links one by one. Nothing is linked without your click."
msgstr "Sprawdź przydziały, a następnie zatwierdź proponowane powiązania jedno po drugim. Nic nie jest wiązane bez Twojego kliknięcia."

msgid "Choose an asset"
msgstr "Wybierz zasób"

msgid "Cores"
msgstr "Rdzenie"

#, php-format
msgid "Cost of the month: %s"
msgstr "Koszt miesiąca: %s"

msgid "Cost per month"
msgstr "Koszt miesięczny"


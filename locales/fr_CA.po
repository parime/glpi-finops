msgid "Settings saved."
msgstr "Réglages enregistrés."

msgid "Choose an entity you have access to."
msgstr "Choisissez une entité à laquelle vous avez accès."

msgid "Choose a CSV file."
msgstr "Choisissez un fichier CSV."

msgid "Only .csv and .txt files are accepted."
msgstr "Seuls les fichiers .csv et .txt sont acceptés."

msgid "No valid cost line in the file."
msgstr "Aucune ligne de coût valide dans le fichier."

msgid "The file cannot be read."
msgstr "Le fichier ne peut pas être lu."

msgid "The preview has expired: upload the file again."
msgstr "L'aperçu a expiré : déposez de nouveau le fichier."

msgid "Import done: %1$d new lines, %2$d already known, %3$d rejected."
msgstr "Import terminé : %1$d nouvelles lignes, %2$d déjà connues, %3$d rejetées."

msgid "Import deleted with its cost lines."
msgstr "Import supprimé avec ses lignes de coût."

msgid "Link removed."
msgstr "Rattachement retiré."

msgid "Resource linked to the asset."
msgstr "Ressource rattachée à l'actif."

msgid "Choose an asset you can see."
msgstr "Choisissez un actif que vous pouvez voir."

msgid "General"
msgstr "Général"

msgid "Cost sources"
msgstr "Sources de coûts"

msgid "About"
msgstr "À propos"

msgid "Cost import"
msgid_plural "Cost imports"
msgstr[0] "Import de coûts"
msgstr[1] "Imports de coûts"

msgid "Cost line"
msgid_plural "Cost lines"
msgstr[0] "Ligne de coût"
msgstr[1] "Lignes de coût"

msgid "The file is larger than the size allowed in the settings."
msgstr "Le fichier dépasse la taille autorisée dans les réglages."

msgid "The file is empty."
msgstr "Le fichier est vide."

msgid "The file is not a text file."
msgstr "Le fichier n'est pas un fichier texte."

msgid "The file contains program code and was refused."
msgstr "Le fichier contient du code de programme et a été refusé."

msgid "Required columns missing: %s."
msgstr "Colonnes obligatoires absentes : %s."

msgid "The file has too many columns."
msgstr "Le fichier a trop de colonnes."

msgid "The file has too many lines."
msgstr "Le fichier a trop de lignes."

msgid "Invalid date (expected YYYY-MM-DD or DD/MM/YYYY)."
msgstr "Date invalide (AAAA-MM-JJ ou JJ/MM/AAAA attendu)."

msgid "Missing or invalid provider."
msgstr "Fournisseur absent ou invalide."

msgid "Invalid cost (expected a number)."
msgstr "Coût invalide (nombre attendu)."

msgid "Invalid currency (expected a three-letter code)."
msgstr "Devise invalide (code de trois lettres attendu)."

msgid "Too many cells on the line."
msgstr "Trop de cellules sur la ligne."

msgid "FinOps"
msgstr "FinOps"

msgid "Costs"
msgstr "Coûts"

msgid "Import"
msgstr "Import"

msgid "Cloud and virtualisation costs"
msgstr "Coûts du cloud et de la virtualisation"

msgid "Import costs"
msgstr "Importer des coûts"

msgid "Link resources to assets"
msgstr "Rattacher les ressources aux actifs"

msgid "Delete an import"
msgstr "Supprimer un import"

msgid "Resource"
msgid_plural "Resources"
msgstr[0] "Ressource"
msgstr[1] "Ressources"

msgid "Generic CSV file"
msgstr "Fichier CSV générique"

msgid "Any billing export brought back to the common columns: date, provider, account, service, resource, cost, currency, tags."
msgstr "Tout export de facturation ramené aux colonnes communes : date, fournisseur, compte, service, ressource, coût, devise, étiquettes."

msgid "What is expected:"
msgstr "Ce qui est attendu :"

msgid "What is this page for?"
msgstr "À quoi sert cette page ?"

msgid "AWS, Azure, Google Cloud, Proxmox, Hyper-V and VMware are planned: see the roadmap issues of the project."
msgstr "AWS, Azure, Google Cloud, Proxmox, Hyper-V et VMware sont prévus : voir les issues de la feuille de route du projet."

msgid "All the settings of the FinOps plugin, and only here."
msgstr "Tous les réglages du plugin FinOps, et seulement ici."

msgid "Available"
msgstr "Disponible"

msgid "Choose the default currency and the largest file accepted, then check which cost sources are available."
msgstr "Choisissez la devise par défaut et la taille maximale d'un fichier, puis vérifiez les sources de coûts disponibles."

msgid "Default currency"
msgstr "Devise par défaut"

msgid "File upload"
msgstr "Dépôt de fichier"

msgid "ISO 4217 code (EUR, USD, GBP...), used when a cost line gives no currency."
msgstr "Code ISO 4217 (EUR, USD, GBP...), utilisé quand une ligne de coût ne donne pas de devise."

msgid "Larger files are refused before being read. Between %1$s and %2$s MB."
msgstr "Les fichiers plus gros sont refusés avant d'être lus. Entre %1$s et %2$s Mo."

msgid "Largest cost file (MB)"
msgstr "Taille maximale d'un fichier de coûts (Mo)"

msgid "License"
msgstr "Licence"

msgid "Open the costs (Management > FinOps)"
msgstr "Ouvrir les coûts (Gestion > FinOps)"

msgid "Planned"
msgstr "Prévue"

msgid "Read-only API"
msgstr "API en lecture seule"

msgid "Source"
msgstr "Source"

msgid "Status"
msgstr "État"

msgid "The plugin only reads from the providers: it never stops, deletes or changes anything on their side."
msgstr "Le plugin ne fait que lire chez les fournisseurs : il n'arrête, ne supprime ni ne modifie rien chez eux."

msgid "Type"
msgstr "Type"

msgid "Version"
msgstr "Version"

msgid "%s already imported"
msgstr "%s déjà importées"

msgid "%s new lines"
msgstr "%s nouvelles lignes"

msgid "%s rejected"
msgstr "%s rejetées"

msgid "Account"
msgstr "Compte"

msgid "Bring the costs of a provider into GLPI from a CSV file, whatever the provider."
msgstr "Ramener dans GLPI les coûts d'un fournisseur depuis un fichier CSV, quel que soit le fournisseur."

msgid "By"
msgstr "Par"

msgid "CSV file"
msgstr "Fichier CSV"

msgid "CSV or text file, %s MB at most."
msgstr "Fichier CSV ou texte, %s Mo au plus."

msgid "Cost"
msgstr "Coût"

msgid "Date"
msgstr "Date"

msgid "Dates as YYYY-MM-DD or DD/MM/YYYY. Without currency, %s is used. Tags as key=value;key2=value2 or a JSON object."
msgstr "Dates au format AAAA-MM-JJ ou JJ/MM/AAAA. Sans devise, %s est utilisée. Étiquettes au format clé=valeur;clé2=valeur2 ou objet JSON."

msgid "Delete"
msgstr "Supprimer"

msgid "Delete this import and its cost lines?"
msgstr "Supprimer cet import et ses lignes de coût ?"

msgid "Expected columns"
msgstr "Colonnes attendues"

msgid "File"
msgstr "Fichier"

msgid "First line: column names. Separator: comma, semicolon or tab. Other names accepted for each column:"
msgstr "Première ligne : noms des colonnes. Séparateur : virgule, point-virgule ou tabulation. Autres noms acceptés pour chaque colonne :"

msgid "First new lines"
msgstr "Premières lignes nouvelles"

msgid "Import a cost file"
msgstr "Importer un fichier de coûts"

msgid "Import log"
msgstr "Journal des imports"

msgid "Import the new lines"
msgstr "Importer les nouvelles lignes"

msgid "Line %1$s: %2$s"
msgstr "Ligne %1$s : %2$s"

msgid "Months"
msgstr "Mois"

msgid "New costs"
msgstr "Nouveaux coûts"

msgid "No import yet."
msgstr "Aucun import pour l'instant."

msgid "Preview"
msgstr "Aperçu"

msgid "Preview before import"
msgstr "Aperçu avant import"

msgid "Provider"
msgstr "Fournisseur"

msgid "Providers"
msgstr "Fournisseurs"

msgid "Rejected lines"
msgstr "Lignes rejetées"

msgid "Result"
msgstr "Résultat"

msgid "Service"
msgstr "Service"

msgid "The cost lines and resources belong to this entity."
msgstr "Les lignes de coût et les ressources appartiennent à cette entité."

msgid "Upload the file, check the preview, then confirm. Importing the same file again creates no duplicate."
msgstr "Déposez le fichier, vérifiez l'aperçu, puis confirmez. Importer de nouveau le même fichier ne crée aucun doublon."

msgid "required"
msgstr "obligatoire"

msgid "Amounts in different currencies are never added up: one table per currency."
msgstr "Les montants dans des devises différentes ne sont jamais additionnés : une table par devise."

msgid "Cost lines"
msgstr "Lignes de coût"

msgid "Costs by provider and by month"
msgstr "Coûts par fournisseur et par mois"

msgid "Export the costs of your provider as CSV, then import the file."
msgstr "Exportez les coûts de votre fournisseur en CSV, puis importez le fichier."

msgid "Import a cost file, then review the months and providers that cost the most."
msgstr "Importez un fichier de coûts, puis examinez les mois et les fournisseurs qui coûtent le plus."

msgid "Last import"
msgstr "Dernier import"

msgid "Month"
msgstr "Mois"

msgid "No cost imported yet"
msgstr "Aucun coût importé pour l'instant"

msgid "Resources"
msgstr "Ressources"

msgid "Resources not linked to an asset"
msgstr "Ressources non rattachées à un actif"

msgid "This page shows what your cloud and virtualised resources cost, by provider and by month."
msgstr "Cette page montre ce que coûtent vos ressources cloud et virtualisées, par fournisseur et par mois."

msgid "Total"
msgstr "Total"

msgid "Cost by month"
msgstr "Coût par mois"

msgid "Link a resource to this asset from Management > FinOps > Resources."
msgstr "Rattachez une ressource à cet actif depuis Gestion > FinOps > Ressources."

msgid "Linked resources"
msgstr "Ressources rattachées"

msgid "No billed resource is linked to this asset"
msgstr "Aucune ressource facturée n'est rattachée à cet actif"

msgid "Total cost"
msgstr "Coût total"

msgid "%1$s to %2$s of %3$s"
msgstr "%1$s à %2$s sur %3$s"

msgid "Asset"
msgstr "Actif"

msgid "Computers, appliances and network devices of the entity of the resource."
msgstr "Ordinateurs, applications et matériels réseau de l'entité de la ressource."

msgid "Each resource billed by a provider (instance, VM, database, disk...) and the GLPI asset it belongs to."
msgstr "Chaque ressource facturée par un fournisseur (instance, VM, base de données, disque...) et l'actif GLPI auquel elle appartient."

msgid "Last seen"
msgstr "Vue pour la dernière fois"

msgid "Link"
msgstr "Rattacher"

msgid "Link the resources shown in orange to the computer, appliance or network device they run on."
msgstr "Rattachez les ressources marquées en orange à l'ordinateur, l'application ou le matériel réseau sur lequel elles tournent."

msgid "Linked asset"
msgstr "Actif rattaché"

msgid "No resource to show"
msgstr "Aucune ressource à afficher"

msgid "Not linked"
msgstr "Non rattachée"

msgid "Not linked only"
msgstr "Non rattachées seulement"

msgid "Open"
msgstr "Ouvrir"

msgid "Remove the link"
msgstr "Retirer le rattachement"

msgid "Resources appear here when a cost file names them (resource column)."
msgstr "Les ressources apparaissent ici quand un fichier de coûts les nomme (colonne resource)."

msgid "Search"
msgstr "Rechercher"

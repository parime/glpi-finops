{# Encadré « Version du plugin » (charte section 9 bis), en tête de l'onglet Général de la page de
   configuration. Reçoit le tableau de PluginVersion::status() :
   {% include '@finops/_plugin_version.html.twig' with {plugin_version: plugin_version} %} #}
{% set pv = plugin_version %}
{% set reasons = {
   'disabled':         __('the check is turned off in the settings below', 'finops'),
   'unreachable':      __('GitHub cannot be reached from the GLPI server (no Internet access, proxy or firewall)', 'finops'),
   'rate_limited':     __('the GitHub request limit is reached, a new attempt will be made within an hour', 'finops'),
   'timeout':          __('GitHub did not answer within 3 seconds', 'finops'),
   'no_release':       __('no release is published on GitHub yet', 'finops'),
   'invalid_response': __('the answer from GitHub could not be read', 'finops'),
} %}
<div class="card card-sm mb-3" id="finops-plugin-version">
   <div class="card-body d-flex align-items-start gap-3">
      <i class="ti ti-brand-github fs-1 text-muted"></i>
      <div class="flex-fill">
         <div class="fw-bold mb-1">{{ __('Plugin version', 'finops') }}</div>
         <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="text-muted small">{{ __('Installed version', 'finops') }}</span>
            <span class="badge bg-primary-subtle text-primary-emphasis"><i class="ti ti-package me-1"></i>v{{ pv.installed }}</span>
            {% if pv.latest %}
               <span class="text-muted small">{{ __('Latest release on GitHub', 'finops') }}</span>
               <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-tag me-1"></i>v{{ pv.latest }}</span>
            {% endif %}

            {% if pv.state == 'up_to_date' %}
               {% include '@finops/_badge.html.twig' with {kind: 'ok', label: __('Up to date', 'finops')} %}
            {% elseif pv.state == 'update_available' %}
               {% include '@finops/_badge.html.twig' with {
                  kind: 'warning',
                  label: __('Update available: %s', 'finops')|format('v' ~ pv.latest),
               } %}
            {% else %}
               {% include '@finops/_badge.html.twig' with {kind: 'neutral', label: __('Latest version unknown', 'finops')} %}
            {% endif %}
         </div>

         {% if pv.state == 'update_available' %}
            <div class="mt-2 d-flex flex-wrap gap-2">
               <a href="{{ pv.release_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                  <i class="ti ti-notes me-1"></i>{{ __('Release notes', 'finops') }}
               </a>
               {% if pv.download_url %}
                  <a href="{{ pv.download_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                     <i class="ti ti-download me-1"></i>{{ __('Download the archive', 'finops') }}
                  </a>
               {% endif %}
            </div>
         {% endif %}

         {% if pv.reason %}
            <div class="text-muted small mt-2">
               <i class="ti ti-info-circle me-1"></i>
               {% if pv.stale %}
                  {{ __('Last check failed: %s.', 'finops')|format(reasons[pv.reason] ?? pv.reason) }}
                  {{ __('Result of the last successful check (%s) shown.', 'finops')|format(pv.last_success|formatted_datetime) }}
               {% else %}
                  {{ __('Reason: %s.', 'finops')|format(reasons[pv.reason] ?? pv.reason) }}
                  {% if pv.reason != 'disabled' %}
                     {% if pv.last_success %}
                        {{ __('Last successful check: %s.', 'finops')|format(pv.last_success|formatted_datetime) }}
                     {% else %}
                        {{ __('No successful check yet.', 'finops') }}
                     {% endif %}
                  {% endif %}
               {% endif %}
               {% if pv.reason != 'disabled' %}
                  <a href="{{ pv.release_url }}" target="_blank" rel="noopener noreferrer">{{ __('See the releases on GitHub', 'finops') }}</a>
               {% endif %}
            </div>
         {% elseif pv.checked_at %}
            <div class="text-muted small mt-2">
               <i class="ti ti-clock me-1"></i>{{ __('Last checked: %s (checked again every 12 hours).', 'finops')|format(pv.checked_at|formatted_datetime) }}
            </div>
         {% endif %}
      </div>
   </div>
</div>

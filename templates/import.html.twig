{# Import d'un fichier de coûts : dépôt (étape 1), aperçu et confirmation (étape 2), journal. #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="container-fluid mt-2">
   {% include '@finops/_page_help.html.twig' with {
      page: 'import',
      purpose: __('Bring the costs of a provider into GLPI from a CSV file, whatever the provider.', 'finops'),
      expected: __('Upload the file, check the preview, then confirm. Importing the same file again creates no duplicate.', 'finops'),
   } %}

   {% include '@finops/_section_nav.html.twig' with {tabs: tabs} %}

   {% if preview %}
      <div class="card mb-3">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-eye me-2"></i>{{ __('Preview before import', 'finops') }}</h3>
            <div class="card-actions small text-muted">
               <i class="ti ti-file-spreadsheet me-1"></i>{{ preview.filename }}
               <i class="ti ti-building ms-2 me-1"></i>{{ preview.entity_name }}
            </div>
         </div>
         <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3">
               {% include '@finops/_badge.html.twig' with {kind: 'ok', label: __('%s new lines', 'finops')|format(preview.new)} %}
               {% include '@finops/_badge.html.twig' with {kind: 'neutral', label: __('%s already imported', 'finops')|format(preview.known)} %}
               {% include '@finops/_badge.html.twig' with {
                  kind: preview.rejected > 0 ? 'warning' : 'neutral',
                  label: __('%s rejected', 'finops')|format(preview.rejected)
               } %}
            </div>
            <div class="row">
               <div class="col-md-4">
                  <h4 class="subheader">{{ __('Providers', 'finops') }}</h4>
                  <ul class="list-unstyled">
                     {% for provider, count in preview.providers %}
                        <li><i class="ti ti-cloud me-1"></i>{{ provider }} <span class="text-muted">({{ count }})</span></li>
                     {% endfor %}
                  </ul>
               </div>
               <div class="col-md-4">
                  <h4 class="subheader">{{ __('Months', 'finops') }}</h4>
                  <p>{{ preview.months|join(', ') }}</p>
               </div>
               <div class="col-md-4">
                  <h4 class="subheader">{{ __('New costs', 'finops') }}</h4>
                  <ul class="list-unstyled">
                     {% for currency, total in preview.totals %}
                        <li><strong>{{ total|number_format(2, '.', ' ') }}</strong> {{ currency }}</li>
                     {% endfor %}
                  </ul>
               </div>
            </div>
            {% if preview.sample is not empty %}
               <h4 class="subheader mt-2">{{ __('First new lines', 'finops') }}</h4>
               <div class="table-responsive">
                  <table class="table table-sm table-vcenter">
                     <thead>
                        <tr>
                           <th>{{ __('Date', 'finops') }}</th>
                           <th>{{ __('Provider', 'finops') }}</th>
                           <th>{{ __('Account', 'finops') }}</th>
                           <th>{{ __('Service', 'finops') }}</th>
                           <th>{{ __('Resource', 'finops') }}</th>
                           <th class="text-end">{{ __('Cost', 'finops') }}</th>
                        </tr>
                     </thead>
                     <tbody>
                        {% for line in preview.sample %}
                           <tr>
                              <td>{{ line.usage_date }}</td>
                              <td>{{ line.provider }}</td>
                              <td>{{ line.account }}</td>
                              <td>{{ line.service }}</td>
                              <td class="text-break">{{ line.resource }}</td>
                              <td class="text-end">{{ line.cost|number_format(2, '.', ' ') }} {{ line.currency }}</td>
                           </tr>
                        {% endfor %}
                     </tbody>
                  </table>
               </div>
            {% endif %}
            {% if preview.errors is not empty %}
               <div class="alert alert-warning mt-3">
                  <h4 class="alert-title"><i class="ti ti-alert-triangle me-1"></i>{{ __('Rejected lines', 'finops') }}</h4>
                  <ul class="mb-0">
                     {% for error in preview.errors %}
                        <li>{{ __('Line %1$s: %2$s', 'finops')|format(error.line, error.message) }}</li>
                     {% endfor %}
                  </ul>
               </div>
            {% endif %}
         </div>
         <div class="card-footer d-flex gap-2">
            <form method="post" action="{{ page_url }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
               <input type="hidden" name="token" value="{{ preview.token }}" />
               <button type="submit" name="confirm" value="1" class="btn btn-primary"{{ preview.new == 0 ? ' disabled' : '' }}>
                  <i class="ti ti-check me-1"></i>{{ __('Import the new lines', 'finops') }}
               </button>
            </form>
            <form method="post" action="{{ page_url }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
               <button type="submit" name="cancel" value="1" class="btn btn-outline-secondary">
                  <i class="ti ti-x me-1"></i>{{ __('Cancel') }}
               </button>
            </form>
         </div>
      </div>
   {% else %}
      <form method="post" action="{{ page_url }}" enctype="multipart/form-data">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
         <div class="card mb-3" style="max-width: 1100px;">
            <div class="card-header">
               <h3 class="card-title"><i class="ti ti-file-upload me-2"></i>{{ __('Import a cost file', 'finops') }}</h3>
            </div>
            <div class="card-body">
               {{ fields.dropdownField('Entity', 'entities_id', entity, __('Entity'), {
                  'add_field_html': '<div class="form-hint">' ~ __('The cost lines and resources belong to this entity.', 'finops')|e ~ '</div>',
               }) }}
               <div class="form-field row col-12 mb-2">
                  <label class="col-form-label col-xxl-5 text-xxl-end" for="finops-cost-file">
                     {{ __('CSV file', 'finops') }}
                  </label>
                  <div class="col-xxl-7 field-container">
                     <input type="file" class="form-control" id="finops-cost-file" name="cost_file" required
                            accept=".csv,.txt,text/csv,text/plain" />
                     <div class="form-hint">{{ __('CSV or text file, %s MB at most.', 'finops')|format(max_mb) }}</div>
                  </div>
               </div>
               <div class="mt-3">
                  <h4 class="subheader">{{ __('Expected columns', 'finops') }}</h4>
                  <p class="small text-muted mb-2">
                     {{ __('First line: column names. Separator: comma, semicolon or tab. Other names accepted for each column:', 'finops') }}
                  </p>
                  <ul class="small mb-2">
                     {% for column, aliases in columns %}
                        <li>
                           <code>{{ column }}</code>
                           {% if column in required %}<span class="badge bg-red-lt ms-1">{{ __('required', 'finops') }}</span>{% endif %}
                           <span class="text-muted">{{ aliases|join(', ') }}</span>
                        </li>
                     {% endfor %}
                  </ul>
                  <p class="small text-muted mb-0">
                     {{ __('Dates as YYYY-MM-DD or DD/MM/YYYY. Without currency, %s is used. Tags as key=value;key2=value2 or a JSON object.', 'finops')|format(currency) }}
                  </p>
               </div>
            </div>
            <div class="card-footer">
               <button type="submit" name="upload" value="1" class="btn btn-primary">
                  <i class="ti ti-eye me-1"></i>{{ __('Preview', 'finops') }}
               </button>
            </div>
         </div>
      </form>
   {% endif %}

   {% include '@finops/_ovh_read.html.twig' %}

   <div class="card">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-history me-2"></i>{{ __('Import log', 'finops') }}</h3>
      </div>
      {% if imports is empty %}
         <div class="card-body text-muted">{{ __('No import yet.', 'finops') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead>
                  <tr>
                     <th>{{ __('Date', 'finops') }}</th>
                     <th>{{ __('File', 'finops') }}</th>
                     <th>{{ __('Entity') }}</th>
                     <th>{{ __('By', 'finops') }}</th>
                     <th>{{ __('Result', 'finops') }}</th>
                     {% if can_purge %}<th></th>{% endif %}
                  </tr>
               </thead>
               <tbody>
                  {% for import in imports %}
                     <tr>
                        <td>{{ import.date }}</td>
                        <td class="text-break">{{ import.filename }}</td>
                        <td>{{ import.entity }}</td>
                        <td>{{ import.user }}</td>
                        <td>
                           {% include '@finops/_badge.html.twig' with {kind: 'ok', label: __('%s new lines', 'finops')|format(import.created)} %}
                           {% include '@finops/_badge.html.twig' with {kind: 'neutral', label: __('%s already imported', 'finops')|format(import.known)} %}
                           {% if import.rejected > 0 %}
                              {% include '@finops/_badge.html.twig' with {kind: 'warning', label: __('%s rejected', 'finops')|format(import.rejected)} %}
                           {% endif %}
                        </td>
                        {% if can_purge %}
                           <td class="text-end">
                              <form method="post" action="{{ page_url }}"
                                    onsubmit="return confirm('{{ __('Delete this import and its cost lines?', 'finops')|e('js') }}');">
                                 <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
                                 <input type="hidden" name="id" value="{{ import.id }}" />
                                 <button type="submit" name="purge" value="1" class="btn btn-sm btn-outline-danger">
                                    <i class="ti ti-trash me-1"></i>{{ __('Delete', 'finops') }}
                                 </button>
                              </form>
                           </td>
                        {% endif %}
                     </tr>
                  {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>
</div>

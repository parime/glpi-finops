{# Page de configuration du plugin, en onglets (charte section 9) : réglages généraux, sources de
   coûts, à propos. Un formulaire par onglet qui en a besoin, aide visible sous chaque champ. #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="container-fluid mt-2">
   {% include '@finops/_page_help.html.twig' with {
      page: 'config',
      purpose: __('All the settings of the FinOps plugin, and only here.', 'finops'),
      expected: __('Choose the default currency and the largest file accepted, then check which cost sources are available.', 'finops'),
   } %}

   {% include '@finops/_section_nav.html.twig' with {tabs: tabs} %}

   {% if tab == 'general' %}
      {# Premier bloc de la page, en tête du premier onglet (charte du modèle, section 9 bis). #}
      <div style="max-width: 1100px;">
         {% include '@finops/_plugin_version.html.twig' with {plugin_version: plugin_version} %}
      </div>
      <form method="post" action="">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
         <div class="card" style="max-width: 1100px;">
            <div class="card-header">
               <h3 class="card-title"><i class="ti ti-settings me-2"></i>{{ __('General', 'finops') }}</h3>
            </div>
            <div class="card-body">
               {{ fields.textField('default_currency', values.default_currency, __('Default currency', 'finops'), {
                  'maxlength': 3,
                  'add_field_html': '<div class="form-hint">' ~ __('ISO 4217 code (EUR, USD, GBP...), used when a cost line gives no currency.', 'finops')|e ~ '</div>',
               }) }}
               {{ fields.numberField('max_upload_mb', values.max_upload_mb, __('Largest cost file (MB)', 'finops'), {
                  'min': min_mb,
                  'max': max_mb,
                  'step': 1,
                  'add_field_html': '<div class="form-hint">' ~ __('Larger files are refused before being read. Between %1$s and %2$s MB.', 'finops')|format(min_mb, max_mb)|e ~ '</div>',
               }) }}
               {{ fields.textField('mandatory_tags', values.mandatory_tags, __('Mandatory tags', 'finops'), {
                  'maxlength': 1000,
                  'add_field_html': '<div class="form-hint">' ~ __('Tag keys every resource should carry, separated by commas (for example owner, cost-center, env). Letter case is ignored. Leave empty to turn the check off.', 'finops')|e ~ '</div>',
               }) }}
               {{ fields.textField('owner_tag', values.owner_tag, __('Owner tag', 'finops'), {
                  'maxlength': 100,
                  'add_field_html': '<div class="form-hint">' ~ __('Tag whose value names the owner of the resource: a GLPI login or email address. Without a matching user, the owner is shown in orange. Leave empty to skip the owner check.', 'finops')|e ~ '</div>',
               }) }}
               {{ fields.sliderField('version_check', values.version_check, __('Check for new versions on GitHub', 'finops'), {
                  'add_field_html': '<div class="form-hint">' ~ __('Reads the latest release published on GitHub at most every 12 hours, without sending any information about this GLPI. Turn it off on a server without Internet access.', 'finops')|e ~ '</div>',
               }) }}
            </div>
            <div class="card-footer">
               <button type="submit" name="update" value="1" class="btn btn-primary">
                  <i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}
               </button>
            </div>
         </div>
      </form>
   {% elseif tab == 'sources' %}
      <div class="card" style="max-width: 1100px;">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-plug-connected me-2"></i>{{ __('Cost sources', 'finops') }}</h3>
         </div>
         <div class="card-body">
            <p class="text-muted">
               {{ __('The plugin only reads from the providers: it never stops, deletes or changes anything on their side.', 'finops') }}
            </p>
            <div class="table-responsive">
               <table class="table table-vcenter card-table">
                  <thead>
                     <tr>
                        <th>{{ __('Source', 'finops') }}</th>
                        <th>{{ __('Type', 'finops') }}</th>
                        <th>{{ __('Status', 'finops') }}</th>
                     </tr>
                  </thead>
                  <tbody>
                     {% for source in sources %}
                        <tr>
                           <td>
                              <i class="{{ source.icon }} me-1"></i><strong>{{ source.label }}</strong>
                              <div class="small text-muted">{{ source.description }}</div>
                           </td>
                           <td>
                              {% if source.kind == 'file' %}
                                 <span class="badge bg-info-subtle text-info-emphasis"><i class="ti ti-file-upload me-1"></i>{{ __('File upload', 'finops') }}</span>
                              {% else %}
                                 <span class="badge bg-info-subtle text-info-emphasis"><i class="ti ti-api me-1"></i>{{ __('Read-only API', 'finops') }}</span>
                              {% endif %}
                           </td>
                           <td>
                              {% if source.available %}
                                 {% include '@finops/_badge.html.twig' with {kind: 'ok', label: __('Available', 'finops')} %}
                              {% else %}
                                 {% include '@finops/_badge.html.twig' with {kind: 'neutral', label: __('Planned', 'finops')} %}
                              {% endif %}
                           </td>
                        </tr>
                     {% endfor %}
                  </tbody>
               </table>
            </div>
            <p class="small text-muted mt-3 mb-0">
               <i class="ti ti-map me-1"></i>{{ __('AWS, Azure, Google Cloud, Proxmox, Hyper-V and VMware are planned: see the roadmap issues of the project.', 'finops') }}
            </p>
         </div>
      </div>
      {% include '@finops/_ovh_accounts.html.twig' %}
      {% include '@finops/_sangfor_accounts.html.twig' %}
   {% else %}
      <div class="card" style="max-width: 1100px;">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-info-circle me-2"></i>{{ __('About', 'finops') }}</h3>
         </div>
         <div class="card-body">
            <p><strong>{{ __('Version', 'finops') }}</strong> {{ version }}</p>
            <p><strong>{{ __('License', 'finops') }}</strong> GPL-3.0-or-later</p>
            <p class="mb-0">
               <i class="ti ti-map-pin me-1"></i>{{ __('Daily use (costs, resources, import): menu Management > FinOps.', 'finops') }}
            </p>
         </div>
      </div>
   {% endif %}
</div>
